{
	"include": ["src/**/*.ts"],
	"exclude": ["**/node_modules"],
	"compilerOptions": {
		"module": "nodenext",
		"target": "esnext",
		"types": [],
		"declaration": true,
		"declarationMap": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"strict": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	}
}